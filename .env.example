# ===== Môi trường =====
# production: bật HSTS, bắt buộc cấu hình an toàn (xem src/config/startupChecks.js).
# Khi chạy trên máy dev hãy đổi thành development.
NODE_ENV=production
PORT=5000
# URL công khai của website (dùng cho sitemap.xml), ví dụ https://chodocu.example
PUBLIC_URL=
# Số lớp reverse proxy phía trước (Nginx/Cloudflare/PaaS thường là 1). Để TRỐNG nếu chạy trực tiếp, không có proxy.
# Đặt sai/thiếu khi có proxy: mọi người dùng bị tính chung 1 IP và dùng chung giới hạn tần suất.
TRUST_PROXY=
# Chỉ đặt khi frontend nằm ở domain KHÁC với API (cách nhau bằng dấu phẩy). Mặc định: không bật CORS.
CORS_ORIGINS=

# ===== SQL Server =====
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=WebBanDoCu
# Tài khoản ứng dụng: chỉ cần quyền đọc/ghi dữ liệu (db_datareader + db_datawriter).
DB_USER=chodocu_app
DB_PASSWORD=
# Mã hóa kết nối. Mặc định bật ở production; đặt DB_TRUST_CERT=false nếu server có chứng chỉ hợp lệ.
DB_ENCRYPT=true
DB_TRUST_CERT=true
# Tài khoản RIÊNG có quyền DDL (db_ddladmin) để chạy `npm run migrate`. Không dùng cho ứng dụng.
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=
# Tự migrate khi khởi động: mặc định BẬT ở dev, TẮT ở production. Production hãy chạy `npm run migrate`.
AUTO_MIGRATE=false

# ===== Khóa bí mật =====
# BẮT BUỘC ở production, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

# ===== Tài khoản admin đầu tiên (chỉ dùng khi tạo lần đầu) =====
# Mật khẩu tối thiểu 12 ký tự, KHÔNG dùng mật khẩu mẫu. Server từ chối khởi động ở production nếu mật khẩu yếu.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên
ADMIN_PHONE=

# Tài khoản/dữ liệu demo (demo.seller@example.com / 123456). KHÔNG bật ở production.
SEED_DEMO=false

# ===== Email (OTP đăng ký / quên mật khẩu) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== Google Maps (chỉ dùng phía server để geocode địa chỉ xem hàng) =====
# Hãy tạo key MỚI (key cũ từng bị lộ qua /api/config/maps), giới hạn theo IP máy chủ + chỉ bật Geocoding API.
GOOGLE_MAPS_API_KEY=
# Tắt geocoding (không gọi Google, không lưu tọa độ): đặt false. Xem docs/PHAP_LY_VA_BAN_QUYEN.md về điều khoản lưu tọa độ.
GEOCODING_ENABLED=true
